    "oci-identity": "^2.117.0",
    "oci-objectstorage": "^2.117.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
